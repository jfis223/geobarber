# MongoDB (Atlas free tier works — needs to be a replica set for Prisma transactions)
DATABASE_URL="mongodb+srv://user:password@cluster0.example.mongodb.net/geobarber?retryWrites=true&w=majority"

# Clerk (https://dashboard.clerk.com — free tier)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Comma-separated Clerk user IDs to bootstrap as admin before any admin
# exists in the DB (§2 of geobarber-spec.md). Once a Customer has
# role=ADMIN, the DB role is authoritative; this stays a fallback.
ADMIN_CLERK_USER_IDS="user_xxx"

# Self-hosted Nominatim instance — never point this at the public
# nominatim.openstreetmap.org endpoint (usage policy forbids sustained
# commercial use; NominatimGeocodingService refuses to start against it).
NOMINATIM_BASE_URL="http://localhost:8088"

# Not wired into app code yet (no TransitRoutingService impl — Phase 5).
# docker-compose.yml + infra/otp/README.md stand up the OTP instance itself;
# this var will matter once the routing service consumes it.
# OTP_BASE_URL="http://localhost:8081/otp/routers/default"

# Not wired up yet (Phase 8 — Resend email):
# RESEND_API_KEY="re_..."
